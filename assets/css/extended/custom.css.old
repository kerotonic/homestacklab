/* ---- CENTRAGE DU BLOC ---- */
.first-entry.home-info {
    text-align: center;
}

.first-entry.home-info .entry-content {
    justify-content: center;
}

/* ---- AGRANDISSEMENT DU TITRE ---- */
.first-entry.home-info h1 {
    font-size: 3.2rem;  /* D'origine autour de 2.5rem - Tu peux tester 3.5rem si tu veux encore plus gros */
    font-weight: 500;   /* Donne un peu plus d'impact au titre */
    margin-bottom: 1rem; /* Donne un peu d'air entre le titre et le texte */
}

/* ---- AGRANDISSEMENT DE LA DESCRIPTION ---- */
.first-entry.home-info .entry-content {
    font-size: 1.2rem;  /* D'origine autour de 1.0rem */
    line-height: 1.6;   /* Améliore la lisibilité avec un interligne plus aéré */
}

/* ---- COLORS ---- */
:root {
    --accent: rgb(52, 109, 122);
}

/* body.dark {
    --accent: rgb(108, 170, 184);
} */
body.dark {
    --accent: rgb(156, 104, 68);
}


/* liens */
a {
    color: var(--accent);
}

/* hover du menu */
.logo a:hover,
#menu a:hover {
    color: var(--accent);
}

/* titre hero */
.first-entry .entry-header h1 {
    color: var(--accent);
}

/* tags */
.post-tags a:hover {
    background: var(--accent);
}
